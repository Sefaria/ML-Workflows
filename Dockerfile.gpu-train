# GPU training image for encoder pretraining (ModernBERT). The default Dockerfile stays on
# torch 2.3.1 for the other flows; this one has a newer torch so a flash-attn wheel exists.
FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends fonts-dejavu-core git \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Fail the build, not the pods, if the dependency set cannot import.
RUN python -c "from transformers import Trainer; import datasets, sentence_transformers"

# Prebuilt flash-attn wheel matching torch 2.5 / CUDA 12 / Python 3.11. If it cannot be installed the
# image still builds and the flows fall back to SDPA attention (slower); check the training report's
# attn_implementation field. Override the wheel with --build-arg FLASH_ATTN_WHEEL=<url>.
ARG FLASH_ATTN_WHEEL=https://github.com/Dao-AILab/flash-attention/releases/download/v2.7.4.post1/flash_attn-2.7.4.post1+cu12torch2.5cxx11abiFALSE-cp311-cp311-linux_x86_64.whl
RUN pip install --no-cache-dir "${FLASH_ATTN_WHEEL}" \
    || echo "WARNING: flash-attn wheel install failed; falling back to SDPA attention"

COPY app/ .
